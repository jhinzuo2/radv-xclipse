 static bool
 radv_xclipse_ibcache_cacheable(const struct radv_amdgpu_winsys_bo *bo)
 {
+   /* DEBUG: RADV_XCLIPSE_NO_IBCACHE=1 disables parking/reuse of BOs (bisect aid). */
+   static int no_ibcache = -1;
+   if (no_ibcache < 0) {
+      const char *e = getenv("RADV_XCLIPSE_NO_IBCACHE");
+      no_ibcache = e && e[0] == '1';
